<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | Binette</title>
<style>
:root { color-scheme: light dark; font-family: system-ui, sans-serif; line-height: 1.7; }
* { box-sizing: border-box; }
body { margin: auto; max-width: 90rem; padding: 1rem; display: grid; grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr); gap: 2rem; }
nav, main { min-width: 0; overflow-wrap: anywhere; }
nav ul { padding-left: 1.25rem; }
nav a { display: inline-block; padding: .25rem 0; }
a { color: light-dark(#174a9c, #9ec8ff); }
pre { max-width: 100%; overflow-x: auto; padding: 1rem; background: light-dark(#f2f3f5, #24262b); }
code { font-size: .9em; }
table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
th, td { border: 1px solid light-dark(#aaa, #666); padding: .4rem .6rem; }
img { max-width: 100%; height: auto; }
@media (max-width: 48rem) { body { grid-template-columns: minmax(0, 1fr); gap: 1rem; } }
</style>
</head>
<body>
<nav aria-label="ドキュメント一覧">
<a href="/">Binette ドキュメント</a>
<ul>
{{ for entry of search.pages("", "url=asc") }}
<li><a href="{{ entry.url }}">{{ entry.title }}</a></li>
{{ /for }}
<li><a href="/api/">API ドキュメント</a></li>
</ul>
</nav>
<main>{{ content |> safe }}</main>
</body>
</html>
